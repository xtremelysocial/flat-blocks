		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--foreground-alt)",
					"secondary": "var(--wp--preset--color--foreground-alt)",
					"tertiary": "var(--wp--preset--color--foreground-alt)",
					"dark": "var(--wp--preset--color--foreground-alt)",
					"dark-alt": "var(--wp--preset--color--foreground-alt)",
					"midnight-blue": "var(--wp--preset--color--foreground-alt)",
					"black": "var(--wp--preset--color--foreground-alt)",
					"red": "var(--wp--preset--color--foreground-alt)",
					"blue": "var(--wp--preset--color--foreground-alt)",
					"light-yellow": "var(--wp--preset--color--contrast)",
					"light-green": "var(--wp--preset--color--contrast)",
					"neutral": "var(--wp--preset--color--contrast)",
					"base": "var(--wp--preset--color--contrast)"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|dark-alt"
		},
		"typography": {
			"fontWeight": "300"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|highlight" },
				":hover": { "color": { "text": "var:preset|color|highlight-alt" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|dark",
					"text": "var:preset|color|foreground-alt"
				},
				"typography": { "fontWeight": "400" },
				"border": { "radius": "4px" },
				":hover": {
					"color": {
						"background": "var:preset|color|dark-alt",
						"text": "var:preset|color|foreground-alt"
					}
				}
			},
			"heading": {
				"typography": { "fontWeight": "400", "letterSpacing": "-0.01em" }
			}
		},
		"css": "body { -webkit-font-smoothing: antialiased; } h1, h2, h3, h4, h5, h6 { color: var(--wp--preset--color--dark); letter-spacing: -0.02em; }"
	}
