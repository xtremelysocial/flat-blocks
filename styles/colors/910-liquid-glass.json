{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Cupertino Glass",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "foreground-alt", "color": "#FFFFFF", "name": "White" },
				{ "slug": "primary", "color": "#000000", "name": "Solid Black" },
				{ "slug": "primary-alt", "color": "#1D1D1F", "name": "Shark Black" },
				{ "slug": "secondary", "color": "#86868B", "name": "Cool Gray" },
				{ "slug": "secondary-alt", "color": "#6E6E73", "name": "Deep Gray" },
				{ "slug": "tertiary", "color": "#FFFFFF", "name": "Pure White" },
				{ "slug": "tertiary-alt", "color": "#F5F5F7", "name": "System Gray" },
				{ "slug": "neutral", "color": "#E8E8ED", "name": "Plate Gray" },
				{ "slug": "neutral-alt", "color": "#D2D2D7", "name": "Silver Gray" },
				{ "slug": "dark", "color": "#1D1D1F", "name": "Dark" },
				{ "slug": "dark-alt", "color": "#000000", "name": "Dark Alt" },
				{ "slug": "base", "color": "#F5F5F7", "name": "Base" },
				{ "slug": "contrast", "color": "#1D1D1F", "name": "Contrast" },
				{ "slug": "highlight", "color": "#0066CC", "name": "Apple Blue" },
				{ "slug": "highlight-alt", "color": "#004499", "name": "Deep Blue" }
			]
		},
		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--foreground-alt)",
					"primary-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary": "var(--wp--preset--color--foreground-alt)",
					"secondary-alt": "var(--wp--preset--color--foreground-alt)",
					"dark": "var(--wp--preset--color--foreground-alt)",
					"dark-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary": "var(--wp--preset--color--contrast)",
					"off-white": "var(--wp--preset--color--foreground-alt)",
					"light-gray": "var(--wp--preset--color--foreground-alt)",
					"gray": "var(--wp--preset--color--foreground-alt)",
					"light-yellow": "var(--wp--preset--color--foreground-alt)",
					"yellow": "var(--wp--preset--color--foreground-alt)",
					"light-blue": "var(--wp--preset--color--foreground-alt)",
					"light-purple": "var(--wp--preset--color--foreground-alt)",
					"light-red": "var(--wp--preset--color--foreground-alt)",
					"light": "var(--wp--preset--color--foreground-alt)",
					"medium": "var(--wp--preset--color--foreground-alt)",
					"heavy": "var(--wp--preset--color--foreground-alt)",
					"black": "var(--wp--preset--color--foreground-alt)"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontWeight": "400"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|foreground-alt"
				},
				"border": {
					"radius": "8px"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "500"
				}
			}
		},
		"css": "body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; } .is-style-liquid-glass { backdrop-filter: blur(20px) saturate(180%); background-color: rgba(255, 255, 255, 0.7) !important; border: 1px solid rgba(255, 255, 255, 0.3); box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1); }"
	}
}